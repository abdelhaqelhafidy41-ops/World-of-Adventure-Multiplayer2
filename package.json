{
  "name": "world-of-adventure",
  "private": true,
  "version": "1.0.0",
  "description": "World of Adventure 3D open-world exploration game.",
  "author": "World of Adventure",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "node server.ts",
    "build": "vite build",
    "build:staging": "vite build --mode staging",
    "build:production": "vite build --mode production",
    "preview": "vite preview",
    "cap:sync": "cap sync android",
    "android": "npm run build && cap sync android",
    "android:open": "cap open android",
    "android:apk": "npm run build && cap sync android && (cd android && ./gradlew assembleDebug)",
    "electron:dev": "node electron/dev.mjs",
    "electron:build": "npm run build && electron-builder --win --config electron-builder.yml --publish never",
    "electron:dir": "npm run build && electron-builder --win --dir --config electron-builder.yml --publish never",
    "worker:install": "npm --prefix workers/multiplayer install",
    "worker:typecheck": "tsc -p workers/multiplayer/tsconfig.json --noEmit",
    "worker:build": "npm --prefix workers/multiplayer run build",
    "worker:deploy": "npm --prefix workers/multiplayer run deploy:production",
    "worker:deploy:staging": "npm --prefix workers/multiplayer run deploy:staging",
    "worker:deploy:production": "npm --prefix workers/multiplayer run deploy:production",
    "test:multiplayer": "tsx _verify_mp_room.ts",
    "clean": "rm -rf dist release server.js workers/multiplayer/dist workers/multiplayer/dist-staging workers/multiplayer/dist-production",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/cli": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@google/genai": "^3.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "three": "^0.187.0",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}

# ==============================================================================
# Server-side AI configuration (NEVER expose via VITE_* client variables)
# ==============================================================================
# GEMINI_API_KEY: Required for Gemini AI API calls on the local Express server.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where the server applet is hosted.
APP_URL="MY_APP_URL"

# ==============================================================================
# Public Client Configuration (Safe for VITE_* — NEVER place secret keys here!)
# Environments: development | staging | production
# ==============================================================================
# Active environment identifier for web builds
VITE_APP_ENV="development"

# Cloudflare Workers & Durable Objects multiplayer endpoint:
#   Development: http://127.0.0.1:8787
#   Staging:     https://world-of-adventure-multiplayer2-staging.<subdomain>.workers.dev
#   Production:  https://world-of-adventure-multiplayer2.abdelhaq-elhafidy-41.workers.dev
VITE_MULTIPLAYER_URL=""

# Optional legacy alias supported alongside VITE_MULTIPLAYER_URL
# VITE_MULTIPLAYER_WORKER_URL=""

# Canonical web URL used when building shareable multiplayer invite links
#   Development: http://localhost:3000
#   Production:  https://abdelhaqelhafidy41-ops.github.io/World-of-Adventure-Multiplayer2/
PUBLIC_APP_URL=""
VITE_PUBLIC_APP_URL=""

# ==============================================================================
# Cloudflare Worker & CI/CD Secrets (Set via `wrangler secret put` & GitHub Secrets)
# NEVER commit real tokens, account IDs, or signing keys to this repository.
# - CLOUDFLARE_API_TOKEN (GitHub Secret)
# - CLOUDFLARE_ACCOUNT_ID (GitHub Secret)
# - SESSION_HMAC_SECRET (Cloudflare Worker Secret: `npx wrangler secret put SESSION_HMAC_SECRET`)
# ==============================================================================
